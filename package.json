{
  "name": "development-assistant",
  "version": "1.2.10",
  "description": "Toolkit for debugging and customer support.",
  "homepage": "https://github.com/dpripa/development-assistant",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "contributors": [
    {
      "name": "Dmitry Pripa",
      "email": "i@dpripa.com",
      "homepage": "https://github.com/dpripa"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jquery": "^3.5.33",
    "@types/node": "^24.10.1",
    "cross-env": "^7.0.3",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "husky": "^8.0.3",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.4"
  },
  "scripts": {
    "start": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build && cross-env NO_MIN=true vite build",
    "typecheck": "tsc --noEmit",
    "lint-style": "stylelint 'src/**/*.css'",
    "lint-script": "eslint eslint.config.mjs stylelint.config.mjs 'src/**/*.ts' vite.config.ts",
    "fix-style": "stylelint --fix 'src/**/*.css'",
    "fix-script": "eslint --fix eslint.config.mjs stylelint.config.mjs 'src/**/*.ts' vite.config.ts",
    "prepare": "husky install"
  }
}
