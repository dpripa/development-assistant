{
  "name": "dpripa/development-assistant",
  "version": "1.2.10",
  "type": "wordpress-plugin",
  "description": "Toolkit for debugging and customer support.",
  "homepage": "https://github.com/dpripa/development-assistant",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Dmitry Pripa",
      "email": "i@dpripa.com",
      "homepage": "https://github.com/dpripa"
    }
  ],
  "keywords": [
    "wordpress"
  ],
  "config": {
    "platform-check": false,
    "platform": {
      "php": "7.4.33"
    },
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": ">=7.4.0",
    "ext-zip": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.23",
    "wp-coding-standards/wpcs": "^3.4.1",
    "wp-phpunit/wp-phpunit": "7.1.0",
    "yoast/phpunit-polyfills": "^3.1.2"
  },
  "autoload": {
    "psr-4": {
      "WPDevAssist\\": "inc/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPDevAssist\\Tests\\Support\\": "tests/Support/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "fix": "phpcbf",
    "test": "phpunit"
  }
}
